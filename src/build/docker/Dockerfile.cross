# syntax=docker/dockerfile:1.7
# Cross-compile Wails v3 apps to any platform
#
# Darwin: Zig + macOS SDK
# Linux: Native GCC inside a target-platform image (Buildx/QEMU when cross-arch)
# Windows: Zig + bundled mingw
#
# Usage from the repository root (Task handles these mounts automatically):
#   docker buildx build --platform linux/arm64 --load -t wails-cross-linux-arm64 -f src/build/docker/Dockerfile.cross src/build/docker
#   docker buildx build --platform linux/amd64 --load -t wails-cross-linux-amd64 -f src/build/docker/Dockerfile.cross src/build/docker
#   mkdir -p bin
#   docker run --rm -v "$(pwd)/src:/app" -v "$(pwd)/bin:/out" wails-cross darwin arm64
#   docker run --rm -v "$(pwd)/src:/app" -v "$(pwd)/bin:/out" wails-cross darwin amd64
#   docker run --rm --platform linux/amd64 -v "$(pwd)/src:/app" -v "$(pwd)/bin:/out" wails-cross-linux-amd64 linux amd64
#   docker run --rm --platform linux/arm64 -v "$(pwd)/src:/app" -v "$(pwd)/bin:/out" wails-cross-linux-arm64 linux arm64
#   docker run --rm -v "$(pwd)/src:/app" -v "$(pwd)/bin:/out" wails-cross windows amd64
#   docker run --rm -v "$(pwd)/src:/app" -v "$(pwd)/bin:/out" wails-cross windows arm64

FROM --platform=${TARGETPLATFORM} golang:1.27.1-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195

ARG TARGETARCH
ARG TARGETPLATFORM

# Install base tools, GCC, ELF inspection, and GTK/WebKit dev packages for the
# image's target platform. Linux CGO builds are permitted only when this image
# is running as the requested GOARCH; build.sh enforces that invariant again.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl xz-utils file pkg-config gcc libc6-dev \
    libgtk-3-dev libwebkit2gtk-4.1-dev \
    libgtk-4-dev libwebkitgtk-6.0-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Zig - automatically selects correct binary for host architecture
ARG ZIG_VERSION=0.16.0
ARG ZIG_SHA256_AMD64=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
ARG ZIG_SHA256_ARM64=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17
RUN case "${TARGETARCH}" in \
        amd64) ZIG_ARCH=x86_64; ZIG_SHA256="${ZIG_SHA256_AMD64}" ;; \
        arm64) ZIG_ARCH=aarch64; ZIG_SHA256="${ZIG_SHA256_ARM64}" ;; \
        *) echo "unsupported Zig host architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl --fail --location --retry 3 --output /tmp/zig.tar.xz \
        "https://ziglang.org/download/${ZIG_VERSION}/zig-${ZIG_ARCH}-linux-${ZIG_VERSION}.tar.xz" \
    && echo "${ZIG_SHA256}  /tmp/zig.tar.xz" | sha256sum --check --strict - \
    && tar -xJf /tmp/zig.tar.xz -C /opt \
    && rm /tmp/zig.tar.xz \
    && ln -s /opt/zig-${ZIG_ARCH}-linux-${ZIG_VERSION}/zig /usr/local/bin/zig

# Download macOS SDK (required for darwin targets)
ARG MACOS_SDK_VERSION=26.1
ARG MACOS_SDK_SHA256=beee7212d265a6d2867d0236cc069314b38d5fb3486a6515734e76fa210c784c
RUN curl --fail --location --retry 3 --output /tmp/macos-sdk.tar.xz \
        "https://github.com/joseluisq/macosx-sdks/releases/download/${MACOS_SDK_VERSION}/MacOSX${MACOS_SDK_VERSION}.sdk.tar.xz" \
    && echo "${MACOS_SDK_SHA256}  /tmp/macos-sdk.tar.xz" | sha256sum --check --strict - \
    && tar -xJf /tmp/macos-sdk.tar.xz -C /opt \
    && rm /tmp/macos-sdk.tar.xz \
    && mv /opt/MacOSX${MACOS_SDK_VERSION}.sdk /opt/macos-sdk

ENV MACOS_SDK_PATH=/opt/macos-sdk
ENV GOTOOLCHAIN=local

# Create Zig CC wrappers for cross-compilation targets.
# Darwin and Windows use Zig. Linux uses GCC only inside a target-native image.

# Darwin arm64
COPY <<'ZIGWRAP' /usr/local/bin/zcc-darwin-arm64
#!/bin/sh
ARGS=""
SKIP_NEXT=0
for arg in "$@"; do
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -target) SKIP_NEXT=1 ;;
        -mmacosx-version-min=*) ;;
        *) ARGS="$ARGS $arg" ;;
    esac
done
exec zig cc -fno-sanitize=all -target aarch64-macos-none -isysroot /opt/macos-sdk -I/opt/macos-sdk/usr/include -L/opt/macos-sdk/usr/lib -F/opt/macos-sdk/System/Library/Frameworks -w $ARGS
ZIGWRAP
RUN chmod +x /usr/local/bin/zcc-darwin-arm64

# Darwin amd64
COPY <<'ZIGWRAP' /usr/local/bin/zcc-darwin-amd64
#!/bin/sh
ARGS=""
SKIP_NEXT=0
for arg in "$@"; do
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -target) SKIP_NEXT=1 ;;
        -mmacosx-version-min=*) ;;
        *) ARGS="$ARGS $arg" ;;
    esac
done
exec zig cc -fno-sanitize=all -target x86_64-macos-none -isysroot /opt/macos-sdk -I/opt/macos-sdk/usr/include -L/opt/macos-sdk/usr/lib -F/opt/macos-sdk/System/Library/Frameworks -w $ARGS
ZIGWRAP
RUN chmod +x /usr/local/bin/zcc-darwin-amd64

# Windows amd64 - uses Zig's bundled mingw
COPY <<'ZIGWRAP' /usr/local/bin/zcc-windows-amd64
#!/bin/sh
ARGS=""
SKIP_NEXT=0
for arg in "$@"; do
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -target) SKIP_NEXT=1 ;;
        -Wl,*) ;;
        *) ARGS="$ARGS $arg" ;;
    esac
done
exec zig cc -target x86_64-windows-gnu $ARGS
ZIGWRAP
RUN chmod +x /usr/local/bin/zcc-windows-amd64

# Windows arm64 - uses Zig's bundled mingw
COPY <<'ZIGWRAP' /usr/local/bin/zcc-windows-arm64
#!/bin/sh
ARGS=""
SKIP_NEXT=0
for arg in "$@"; do
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -target) SKIP_NEXT=1 ;;
        -Wl,*) ;;
        *) ARGS="$ARGS $arg" ;;
    esac
done
exec zig cc -target aarch64-windows-gnu $ARGS
ZIGWRAP
RUN chmod +x /usr/local/bin/zcc-windows-arm64

# Build script
COPY <<'SCRIPT' /usr/local/bin/build.sh
#!/bin/sh
set -e

OS=${1:-darwin}
ARCH=${2:-arm64}

if [ ! -f go.mod ]; then
    echo "go.mod is missing; mount repository src at /app and repository bin at /out" >&2
    exit 1
fi

normalize_arch() {
    case "$1" in
        amd64|x86_64) echo "amd64" ;;
        arm64|aarch64) echo "arm64" ;;
        *) echo "$1" ;;
    esac
}

case "${OS}-${ARCH}" in
    darwin-arm64|darwin-aarch64)
        export CC=zcc-darwin-arm64
        export GOARCH=arm64
        export GOOS=darwin
        ;;
    darwin-amd64|darwin-x86_64)
        export CC=zcc-darwin-amd64
        export GOARCH=amd64
        export GOOS=darwin
        ;;
    linux-arm64|linux-aarch64)
        export CC=gcc
        export GOARCH=arm64
        export GOOS=linux
        ;;
    linux-amd64|linux-x86_64)
        export CC=gcc
        export GOARCH=amd64
        export GOOS=linux
        ;;
    windows-arm64|windows-aarch64)
        export CC=zcc-windows-arm64
        export GOARCH=arm64
        export GOOS=windows
        ;;
    windows-amd64|windows-x86_64)
        export CC=zcc-windows-amd64
        export GOARCH=amd64
        export GOOS=windows
        ;;
    *)
        echo "Usage: <os> <arch>"
        echo "  os: darwin, linux, windows"
        echo "  arch: amd64, arm64"
        exit 1
        ;;
esac

export CGO_ENABLED=1
export CGO_CFLAGS="-w"

# CGO must never feed ARM64 sources to an AMD64 host compiler (or vice versa).
# The Linux Taskfile builds and runs a target-platform image; these checks make
# the Dockerfile fail closed even if someone invokes it manually or reuses an
# incorrectly tagged local image.
if [ "$GOOS" = "linux" ]; then
    RUNTIME_ARCH=$(normalize_arch "$(uname -m)")
    if [ "$RUNTIME_ARCH" != "$GOARCH" ]; then
        echo "refusing linux/$GOARCH CGO build: container runtime is $RUNTIME_ARCH" >&2
        echo "build and run this image with --platform=linux/$GOARCH; host-architecture gcc is never a valid substitute" >&2
        exit 1
    fi

    CC_TARGET=$($CC -dumpmachine 2>/dev/null || true)
    case "$GOARCH:$CC_TARGET" in
        arm64:aarch64-linux-*|amd64:x86_64-linux-*) ;;
        *)
            echo "refusing linux/$GOARCH CGO build: $CC reports incompatible target '$CC_TARGET'" >&2
            exit 1
            ;;
    esac
fi

# Cross builds consume the host/CI-produced frontend bundle. Keeping Node/npm
# out of this toolchain prevents a second, distro-dependent dependency resolver
# from producing a package that differs from the validated frontend build.
if [ -d "frontend" ] && [ -f "frontend/package.json" ] && [ ! -d "frontend/dist" ]; then
    echo "frontend/dist is missing; run the lockfile-strict frontend build before cross-compiling" >&2
    exit 1
fi

# Build
APP=${APP_NAME:-$(basename $(pwd))}
mkdir -p bin

EXT=""
BUILDINFO_LDFLAGS="-X novera/internal/buildinfo.Version=${NOVERA_BUILD_VERSION:-0.1.0-dev} -X novera/internal/buildinfo.Commit=${NOVERA_BUILD_COMMIT:-unknown} -X novera/internal/buildinfo.BuildDate=${NOVERA_BUILD_DATE:-unknown} -X novera/internal/buildinfo.Channel=${NOVERA_BUILD_CHANNEL:-development}"
LDFLAGS="-s -w ${BUILDINFO_LDFLAGS}"
if [ "$GOOS" = "windows" ]; then
    EXT=".exe"
    LDFLAGS="-s -w -H windowsgui ${BUILDINFO_LDFLAGS}"
fi

TAGS="production"
if [ -n "$EXTRA_TAGS" ]; then
    TAGS="${TAGS},${EXTRA_TAGS}"
fi

OUTPUT="/out/${APP}-${GOOS}-${GOARCH}${EXT}"
go build -tags "$TAGS" -trimpath -buildvcs=false -ldflags="$LDFLAGS" -o "$OUTPUT" .

# Verify that the advertised Linux architecture matches the produced ELF before
# the Taskfile can move it into a release/package path.
if [ "$GOOS" = "linux" ]; then
    FILE_INFO=$(file -b "$OUTPUT")
    case "$GOARCH" in
        arm64)
            case "$FILE_INFO" in
                *"ARM aarch64"*) ;;
                *) echo "linux/arm64 output architecture verification failed: $FILE_INFO" >&2; exit 1 ;;
            esac
            ;;
        amd64)
            case "$FILE_INFO" in
                *"x86-64"*) ;;
                *) echo "linux/amd64 output architecture verification failed: $FILE_INFO" >&2; exit 1 ;;
            esac
            ;;
    esac
    echo "Verified linux/$GOARCH ELF: $FILE_INFO"
fi

echo "Built: $OUTPUT"
SCRIPT
RUN chmod +x /usr/local/bin/build.sh

WORKDIR /app
ENTRYPOINT ["/usr/local/bin/build.sh"]
CMD ["darwin", "arm64"]
