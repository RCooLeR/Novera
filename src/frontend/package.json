{
  "name": "novera-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build": "tsc && vite build --mode production && node scripts/check-production-csp.mjs && node scripts/check-production-entry.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:csp": "node scripts/check-production-csp.mjs",
    "check:entry": "node scripts/check-production-entry.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@wailsio/runtime": "3.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "dompurify": "3.4.17",
    "lucide-react": "^1.69.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "$dompurify",
    "eslint": { "minimatch": "11.0.4" },
    "@eslint/config-array": { "minimatch": "11.0.4" },
    "@typescript-eslint/typescript-estree": { "minimatch": "11.0.4" }
  }
}
