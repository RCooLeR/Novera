<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="novera.exe"
        Arguments=""
        InstallLocation="C:\Program Files\rcooler\Novera">
    </Installer>
    <PackageInformation
        PackageName="Novera"
        PackageDisplayName="Novera"
        PublisherName="CN=rcooler"
        PublisherDisplayName="rcooler"
        Version="0.1.0.0"
        PackageDescription="Local-first AI workbench">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.rcooler.novera"
                Description="Local-first AI workbench"
                DisplayName="Novera"
                ExecutableName="novera.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Novera</DisplayName>
            <PublisherDisplayName>rcooler</PublisherDisplayName>
            <Description>Local-first AI workbench</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="novera.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
