    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
